@page "/AddMachine"
@using MachinePark.Service
@using System.ComponentModel.DataAnnotations
@using System.ComponentModel
@inject MachineStorageService MachineStorageService
@inject MachineService MachineService

@rendermode InteractiveServer


<EditForm Model="@Machine" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
    <DataAnnotationsValidator/>
    <div class="row">
        <div class="col-8">
    <div>
        <label for="serialnumber" >serial number
        <InputText @bind-Value="Machine.SerialNumber" id="serialnumber" type="text"/>
            <ValidationMessage For="@(()=> Machine.SerialNumber)" />
        </label>
    </div>
    <div>
        <label for="machinetype">Machine type:</label>
        <InputSelect @bind-Value="Machine.MachineType">
            <option value="">
                Select machine type...
            </option>
            @foreach (var machinetype in MachineTypeList)
            {
                <option value="@machinetype">
                    @machinetype
                </option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => Machine.MachineType)" />
    </div>
        <button type="submit">Submit</button>

        </div>
    </div>

    @if (displayValidationErrorMessages)
    {
        <div class="col-md-4" style="margin-top:10px">
            <label>Validation Messages: </label>
            <ValidationSummary />
        </div>
    }
</EditForm>

@if (displayMachineAddedToDB)
{
    <div class="row bg-success text-white col-md-4" style="margin-top:10px; height:40px">
        <label class="p-2">Machine added to database... </label>
    </div>
}
