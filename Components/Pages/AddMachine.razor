@page "/AddMachine"
@using MachinePark.Service
@using System.ComponentModel.DataAnnotations
@using System.ComponentModel
@inject MachineStorageService MachineStorageService
@inject MachineService MachineService

@rendermode InteractiveServer


<EditForm Model="@Machine" @OnValidSubmit="@addMachine" >
    <DataAnnotationsValidator/>

    <div>
        <label for="serialnumber" >serial number
        <InputText @bind-Value="Machine.SerialNumber" id="serialnumber" type="text"/>
            <ValidationMessage For="@(()=> Machine.SerialNumber)" />
        </label>
    </div>
    <div>
        <label for="machinetype">Machine type:</label>
        <InputSelect @bind-Value="Machine.MachineType">
            <option value="">
                Select machine type...
            </option>
            @foreach (var machinetype in MachineTypeList)
            {
                <option value="@machinetype">
                    @machinetype
                </option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => Machine.MachineType)" />
    </div>
    <button type="submit"@onclick="@addMachine">Submit</button>
</EditForm>
